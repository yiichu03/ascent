#!/bin/bash
#PBS -N asvosubmap
#PBS -P CFP04-SF-109
#PBS -q auto
#PBS -l select=1:ncpus=24:ngpus=1:mem=384gb
#PBS -l walltime=96:00:00
#PBS -j oe

set -euo pipefail

PROJECT=/scratch/e1538633/liuyi/drift-aware-submap-exploration
SOURCE_ROOT=$PROJECT/external/ascent_vo_submap_v1
RESOURCE_ROOT=$PROJECT/external/ascent
POINTNAV_VO_ROOT=$PROJECT/external/PointNav-VO
WORKER=$SOURCE_ROOT/pbs/run_submap_screen_lane.sh
PREFLIGHT=$SOURCE_ROOT/scripts/preflight_submap_screen.py
LOADING_CHECK=$SOURCE_ROOT/scripts/check_submap_habitat_loading.py
TASK_RESET_CHECK=$SOURCE_ROOT/scripts/check_submap_task_reset.py
SUMMARIZER=$SOURCE_ROOT/scripts/summarize_submap_screen.py
CALIBRATOR=$SOURCE_ROOT/scripts/calibrate_submap_thresholds.py
PORT_SELECTOR=$SOURCE_ROOT/scripts/select_submap_port_block.py

DATASET=${ASCENT_SUBMAP_DATASET:?ASCENT_SUBMAP_DATASET is required}
MODE=${ASCENT_SUBMAP_MODE:?ASCENT_SUBMAP_MODE is required}
MANIFEST=${ASCENT_SUBMAP_MANIFEST:?ASCENT_SUBMAP_MANIFEST is required}
MANIFEST_SHA256=${ASCENT_SUBMAP_MANIFEST_SHA256:?ASCENT_SUBMAP_MANIFEST_SHA256 is required}
EXPECTED_CHUNKS=${ASCENT_SUBMAP_EXPECTED_CHUNKS:?ASCENT_SUBMAP_EXPECTED_CHUNKS is required}
EXPECTED_EPISODES=${ASCENT_SUBMAP_EXPECTED_EPISODES:?ASCENT_SUBMAP_EXPECTED_EPISODES is required}
SOURCE_COMMIT=${ASCENT_SUBMAP_SOURCE_COMMIT:?ASCENT_SUBMAP_SOURCE_COMMIT is required}
RESOURCE_COMMIT=${ASCENT_SUBMAP_RESOURCE_COMMIT:?ASCENT_SUBMAP_RESOURCE_COMMIT is required}
POINTNAV_VO_COMMIT=${ASCENT_SUBMAP_POINTNAV_VO_COMMIT:?ASCENT_SUBMAP_POINTNAV_VO_COMMIT is required}
CONTROLLER_SHA256=${ASCENT_SUBMAP_CONTROLLER_SHA256:?ASCENT_SUBMAP_CONTROLLER_SHA256 is required}
WORKER_SHA256=${ASCENT_SUBMAP_WORKER_SHA256:?ASCENT_SUBMAP_WORKER_SHA256 is required}
STAMP=${ASCENT_SUBMAP_STAMP:?ASCENT_SUBMAP_STAMP is required}
CALIBRATION_MANIFEST=${ASCENT_SUBMAP_CALIBRATION_MANIFEST:-}
CALIBRATION_MANIFEST_SHA256=${ASCENT_SUBMAP_CALIBRATION_MANIFEST_SHA256:-}
CALIBRATION_JSON=${ASCENT_SUBMAP_CALIBRATION_JSON:-}
CALIBRATION_JSON_SHA256=${ASCENT_SUBMAP_CALIBRATION_JSON_SHA256:-}

case "$DATASET" in
  hm3d)
    SCENES_ROOT=/scratch/Projects/CFP-04/CFP04-SF-109/shared/HM3D/versioned_data/hm3d-0.1
    ;;
  mp3d)
    SCENES_ROOT=$RESOURCE_ROOT/data/scene_datasets
    ;;
  *) echo "invalid_dataset=$DATASET"; exit 20 ;;
esac
RUN_CALIBRATION=false
if [ "$DATASET" = hm3d ] && [ "$MODE" = smoke ]; then
  RUN_CALIBRATION=true
fi
if [ "$RUN_CALIBRATION" = true ]; then
  CALIBRATION_CONTRACT=hm3d_train30_native_calibration
elif [ "$DATASET" = mp3d ]; then
  CALIBRATION_CONTRACT=hm3d_train30_frozen_no_mp3d_retuning
else
  CALIBRATION_CONTRACT=hm3d_train30_frozen_reuse
fi

FORWARD_SHA256=6b571bb717366f7d80f61e919b33a45ac2f45925201c4e3011b3239a2c42e586
TURN_SHA256=c469643f9ab35c9e1058f31fbb672a5fa3adf582987a4388bdd020dd89faf1d9
SCRATCH_ROOT=/scratch/e1538633/liuyi
ASCENT_ENV=$SCRATCH_ROOT/micromamba/envs/ascent_nav
ASCENT_PYTHON=$ASCENT_ENV/bin/python
JOB_START_EPOCH=$(date +%s)
RUN_ROOT=$SCRATCH_ROOT/submap_v1_runs/submap_${DATASET}_${MODE}_${PBS_JOBID:-manual}_${STAMP}

case "$MODE" in
  smoke)
    [ "$EXPECTED_CHUNKS" = 1 ] || { echo smoke_chunk_contract; exit 20; }
    [ "$EXPECTED_EPISODES" = 5 ] || { echo smoke_episode_contract; exit 20; }
    LANE_COUNT=1
    DEADLINE_EPOCH=$((JOB_START_EPOCH + 34 * 3600))
    TASK_RESET_TIMEOUT_SECONDS=1800
    if [ "$RUN_CALIBRATION" = true ]; then
      [ -f "$CALIBRATION_MANIFEST" ] || {
        echo smoke_calibration_manifest_missing
        exit 21
      }
      [ "$(sha256sum "$CALIBRATION_MANIFEST" | awk '{print $1}')" = "$CALIBRATION_MANIFEST_SHA256" ] || {
        echo smoke_calibration_manifest_hash_mismatch
        exit 22
      }
    fi
    ;;
  full)
    [ "$EXPECTED_CHUNKS" = 5 ] || { echo full_chunk_contract; exit 20; }
    [ "$EXPECTED_EPISODES" = 150 ] || { echo full_episode_contract; exit 20; }
    LANE_COUNT=3
    DEADLINE_EPOCH=$((JOB_START_EPOCH + 88 * 3600))
    TASK_RESET_TIMEOUT_SECONDS=3600
    ;;
  *) echo "invalid_mode=$MODE"; exit 20 ;;
esac

for path in "$MANIFEST" "$WORKER" "$PREFLIGHT" "$LOADING_CHECK" \
  "$TASK_RESET_CHECK" \
  "$SUMMARIZER" "$CALIBRATOR" "$PORT_SELECTOR"; do
  [ -f "$path" ] || { echo "missing_file=$path"; exit 21; }
done
command -v timeout >/dev/null || { echo missing_timeout; exit 21; }
[ "$(sha256sum "${BASH_SOURCE[0]}" | awk '{print $1}')" = "$CONTROLLER_SHA256" ] || {
  echo controller_hash_mismatch
  exit 22
}
[ "$(sha256sum "$WORKER" | awk '{print $1}')" = "$WORKER_SHA256" ] || {
  echo worker_hash_mismatch
  exit 22
}
[ "$(sha256sum "$MANIFEST" | awk '{print $1}')" = "$MANIFEST_SHA256" ] || {
  echo manifest_hash_mismatch
  exit 22
}
if [ "$RUN_CALIBRATION" = false ]; then
  [ -f "$CALIBRATION_JSON" ] || {
    echo calibration_json_missing
    exit 21
  }
  [ "$(sha256sum "$CALIBRATION_JSON" | awk '{print $1}')" = "$CALIBRATION_JSON_SHA256" ] || {
    echo calibration_json_hash_mismatch
    exit 22
  }
  "$ASCENT_PYTHON" - "$CALIBRATION_JSON" <<'PY'
import json
import sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
assert value["status"] == "PASS"
assert value["navigation_metrics_used"] is False
assert value["config"]["provisional_thresholds"] is False
PY
fi
[ "$(git -C "$SOURCE_ROOT" rev-parse HEAD)" = "$SOURCE_COMMIT" ] || {
  echo source_commit_mismatch
  exit 22
}
[ -z "$(git -C "$SOURCE_ROOT" status --porcelain --untracked-files=all)" ] || {
  echo source_worktree_not_clean
  git -C "$SOURCE_ROOT" status --short
  exit 23
}
[ "$(git -C "$RESOURCE_ROOT" rev-parse HEAD)" = "$RESOURCE_COMMIT" ] || {
  echo resource_commit_mismatch
  exit 22
}
[ "$(git -C "$POINTNAV_VO_ROOT" rev-parse HEAD)" = "$POINTNAV_VO_COMMIT" ] || {
  echo pointnav_vo_commit_mismatch
  exit 22
}
[ ! -e "$RUN_ROOT" ] || { echo "run_root_exists=$RUN_ROOT"; exit 24; }
mkdir -p "$RUN_ROOT"/{checks,lanes,mpl_config,xdg_cache}

export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
export LD_LIBRARY_PATH="$ASCENT_ENV/lib:$ASCENT_ENV/lib64:$ASCENT_ENV/lib/python3.9/site-packages/torch/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$SOURCE_ROOT:$SOURCE_ROOT/third_party/vlfm:$SOURCE_ROOT/third_party/habitat-lab/habitat-lab:$SOURCE_ROOT/third_party/habitat-lab/habitat-baselines:$SOURCE_ROOT/third_party/frontier_exploration:$SOURCE_ROOT/third_party/depth_camera_filtering:$SOURCE_ROOT/third_party/MobileSAM:$SOURCE_ROOT/third_party/GroundingDINO:$SOURCE_ROOT/third_party/D-FINE:$SOURCE_ROOT/third_party/recognize-anything:$SOURCE_ROOT/third_party/places365"
export XDG_CACHE_HOME=$RUN_ROOT/xdg_cache
export MPLCONFIGDIR=$RUN_ROOT/mpl_config

"$ASCENT_PYTHON" "$PREFLIGHT" \
  --manifest "$MANIFEST" \
  --scene-root "$SCENES_ROOT" \
  --expected-dataset "$DATASET" \
  --expected-episodes "$EXPECTED_EPISODES" \
  --expected-chunks "$EXPECTED_CHUNKS" \
  --output-json "$RUN_ROOT/checks/screen_preflight.json" \
  > "$RUN_ROOT/checks/screen_preflight.log"
"$ASCENT_PYTHON" "$LOADING_CHECK" \
  --manifest "$MANIFEST" \
  --config-dir "$SOURCE_ROOT/experiments" \
  --scene-root "$SCENES_ROOT" \
  --output-json "$RUN_ROOT/checks/screen_habitat_loading.json" \
  > "$RUN_ROOT/checks/screen_habitat_loading.log"
timeout --signal=TERM --kill-after=30s \
  "${TASK_RESET_TIMEOUT_SECONDS}s" \
  "$ASCENT_PYTHON" "$TASK_RESET_CHECK" \
    --manifest "$MANIFEST" \
    --config-dir "$SOURCE_ROOT/experiments" \
    --scene-root "$SCENES_ROOT" \
    --gpu-device-id 0 \
    --output-json "$RUN_ROOT/checks/screen_task_reset.json" \
    > "$RUN_ROOT/checks/screen_task_reset.log" 2>&1
if [ "$RUN_CALIBRATION" = true ]; then
  "$ASCENT_PYTHON" "$PREFLIGHT" \
    --manifest "$CALIBRATION_MANIFEST" \
    --scene-root "$SCENES_ROOT" \
    --expected-dataset hm3d \
    --expected-episodes 30 \
    --expected-chunks 1 \
    --output-json "$RUN_ROOT/checks/calibration_preflight.json" \
    > "$RUN_ROOT/checks/calibration_preflight.log"
  "$ASCENT_PYTHON" "$LOADING_CHECK" \
    --manifest "$CALIBRATION_MANIFEST" \
    --config-dir "$SOURCE_ROOT/experiments" \
    --scene-root "$SCENES_ROOT" \
    --output-json "$RUN_ROOT/checks/calibration_habitat_loading.json" \
    > "$RUN_ROOT/checks/calibration_habitat_loading.log"
  timeout --signal=TERM --kill-after=30s \
    "${TASK_RESET_TIMEOUT_SECONDS}s" \
    "$ASCENT_PYTHON" "$TASK_RESET_CHECK" \
      --manifest "$CALIBRATION_MANIFEST" \
      --config-dir "$SOURCE_ROOT/experiments" \
      --scene-root "$SCENES_ROOT" \
      --gpu-device-id 0 \
      --output-json "$RUN_ROOT/checks/calibration_task_reset.json" \
      > "$RUN_ROOT/checks/calibration_task_reset.log" 2>&1
fi
BASE_PORT_ROOT=$(
  "$ASCENT_PYTHON" "$PORT_SELECTOR" \
    --seed "${PBS_JOBID:-manual}:$STAMP" --lanes "$LANE_COUNT"
)
{
  echo schema=ascent_vo_submap_three_shared_controller_v1
  echo scientific_role=paired_representation_method_screen
  echo pbs_jobid=${PBS_JOBID:-manual}
  echo host=$(hostname)
  echo start_time=$(date -Is)
  echo mode=$MODE
  echo dataset=$DATASET
  echo source_root=$SOURCE_ROOT
  echo source_commit=$SOURCE_COMMIT
  echo resource_root=$RESOURCE_ROOT
  echo resource_commit=$RESOURCE_COMMIT
  echo pointnav_vo_commit=$POINTNAV_VO_COMMIT
  echo manifest=$MANIFEST
  echo manifest_sha256=$MANIFEST_SHA256
  echo expected_chunks=$EXPECTED_CHUNKS
  echo expected_episodes=$EXPECTED_EPISODES
  echo calibration_json=$CALIBRATION_JSON
  echo calibration_json_sha256=$CALIBRATION_JSON_SHA256
  echo run_calibration=$RUN_CALIBRATION
  echo calibration_contract=$CALIBRATION_CONTRACT
  echo task_reset_preflight=real_synchronous_objectnav_reset
  echo task_reset_timeout_seconds=$TASK_RESET_TIMEOUT_SECONDS
  echo lane_count=$LANE_COUNT
  echo resource_contract=one_H200_up_to_three_independent_service_lanes
  echo pose_source=zhao_rgbd_2021
  echo policy_gt_isolation=1
  echo evaluation_gt_only=1
  echo no_metric_driven_retry=1
  echo smoke_pair_order=B2_then_B1_fail_fast
  echo full_pair_order=alternating_B1B2_by_chunk
  echo base_port_root=$BASE_PORT_ROOT
  echo deadline_epoch=$DEADLINE_EPOCH
  qstat -f "${PBS_JOBID:-}" 2>/dev/null || true
  nvidia-smi || true
} > "$RUN_ROOT/controller_preflight.txt"

ACTIVE_PIDS=()
cleanup() {
  local status=$?
  set +e
  local pid
  for pid in "${ACTIVE_PIDS[@]:-}"; do
    kill "$pid" 2>/dev/null || true
  done
  for pid in "${ACTIVE_PIDS[@]:-}"; do
    wait "$pid" 2>/dev/null || true
  done
  if [ ! -e "$RUN_ROOT/terminal_status.txt" ]; then
    printf 'controller_exit_status=%s stage=aborted time=%s\n' \
      "$status" "$(date -Is)" > "$RUN_ROOT/terminal_status.txt"
  fi
  return "$status"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

mapfile -t LANE_ROWS < <(
  "$ASCENT_PYTHON" - "$MANIFEST" "$LANE_COUNT" <<'PY'
import json
import sys
from collections import Counter
manifest = json.load(open(sys.argv[1], encoding="utf-8"))
lanes = int(sys.argv[2])
chunks = Counter()
episodes = Counter()
for index, chunk in enumerate(manifest["chunks"]):
    lane = index % lanes
    chunks[lane] += 1
    episodes[lane] += int(chunk["episode_count"])
for lane in range(lanes):
    print(f"{lane}\t{chunks[lane]}\t{episodes[lane]}")
PY
)

PIDS=()
LANE_IDS=()
LANE_LOGS=()
for lane_row in "${LANE_ROWS[@]}"; do
  IFS=$'\t' read -r lane_id lane_chunks lane_episodes <<< "$lane_row"
  lane_log=$RUN_ROOT/lanes/lane_${lane_id}.log
  (
    export ASCENT_SUBMAP_DATASET=$DATASET
    export ASCENT_SUBMAP_MODE=$MODE
    export ASCENT_SUBMAP_SCENES_ROOT=$SCENES_ROOT
    export ASCENT_SUBMAP_RUN_CALIBRATION=$RUN_CALIBRATION
    export ASCENT_SUBMAP_MANIFEST=$MANIFEST
    export ASCENT_SUBMAP_MANIFEST_SHA256=$MANIFEST_SHA256
    export ASCENT_SUBMAP_SOURCE_COMMIT=$SOURCE_COMMIT
    export ASCENT_SUBMAP_RESOURCE_COMMIT=$RESOURCE_COMMIT
    export ASCENT_SUBMAP_POINTNAV_VO_COMMIT=$POINTNAV_VO_COMMIT
    export ASCENT_SUBMAP_LANE_ID=$lane_id
    export ASCENT_SUBMAP_LANE_COUNT=$LANE_COUNT
    export ASCENT_SUBMAP_LANE_EXPECTED_CHUNKS=$lane_chunks
    export ASCENT_SUBMAP_LANE_EXPECTED_EPISODES=$lane_episodes
    export ASCENT_SUBMAP_STAGE_ROOT=$RUN_ROOT/lanes
    export ASCENT_SUBMAP_BASE_PORT=$((BASE_PORT_ROOT + lane_id * 20))
    export ASCENT_SUBMAP_DEADLINE_EPOCH=$DEADLINE_EPOCH
    export ASCENT_SUBMAP_CALIBRATION_MANIFEST=$CALIBRATION_MANIFEST
    export ASCENT_SUBMAP_CALIBRATION_MANIFEST_SHA256=$CALIBRATION_MANIFEST_SHA256
    export ASCENT_SUBMAP_CALIBRATION_JSON=$CALIBRATION_JSON
    export ASCENT_SUBMAP_CALIBRATION_JSON_SHA256=$CALIBRATION_JSON_SHA256
    bash "$WORKER"
  ) > "$lane_log" 2>&1 &
  PIDS+=("$!")
  LANE_IDS+=("$lane_id")
  LANE_LOGS+=("$lane_log")
  ACTIVE_PIDS=("${PIDS[@]}")
done

printf 'lane_id,pid,exit_status,lane_log,inventory\n' \
  > "$RUN_ROOT/lane_status.csv"
WORKER_STATUS=0
for index in "${!PIDS[@]}"; do
  set +e
  wait "${PIDS[$index]}"
  status=$?
  set -e
  lane_id=${LANE_IDS[$index]}
  printf '%s,%s,%s,%s,%s\n' \
    "$lane_id" "${PIDS[$index]}" "$status" "${LANE_LOGS[$index]}" \
    "$RUN_ROOT/lanes/lane_${lane_id}/inventory.csv" \
    >> "$RUN_ROOT/lane_status.csv"
  [ "$status" = 0 ] || WORKER_STATUS=$status
done
ACTIVE_PIDS=()

REGISTRY=$RUN_ROOT/evidence_registry.csv
printf 'lane_id,inventory\n' > "$REGISTRY"
for lane_id in "${LANE_IDS[@]}"; do
  printf '%s,%s\n' "$lane_id" \
    "$RUN_ROOT/lanes/lane_${lane_id}/inventory.csv" >> "$REGISTRY"
done

CALIBRATION_OUTPUT=$CALIBRATION_JSON
CALIBRATION_STATUS=0
if [ "$RUN_CALIBRATION" = true ]; then
  CALIBRATION_OUTPUT=$RUN_ROOT/calibration/calibration.json
  set +e
  "$ASCENT_PYTHON" "$CALIBRATOR" \
    --inventory "$RUN_ROOT/lanes/lane_0/inventory.csv" \
    --manifest "$CALIBRATION_MANIFEST" \
    --output-json "$CALIBRATION_OUTPUT" \
    --source-commit "$SOURCE_COMMIT" \
    --forward-checkpoint-sha256 "$FORWARD_SHA256" \
    --turn-checkpoint-sha256 "$TURN_SHA256" \
    --expected-episodes 30 \
    > "$RUN_ROOT/calibration.log" 2>&1
  CALIBRATION_STATUS=$?
  set -e
fi

SUMMARY_DIR=$RUN_ROOT/final_gate
SUMMARY_STATUS=0
SUMMARY_ARGS=()
if [ "$RUN_CALIBRATION" = false ]; then
  SUMMARY_ARGS+=(--calibration-json "$CALIBRATION_OUTPUT")
fi
set +e
"$ASCENT_PYTHON" "$SUMMARIZER" \
  --manifest "$MANIFEST" \
  --registry "$REGISTRY" \
  --mode "$MODE" \
  --expected-dataset "$DATASET" \
  --expected-episodes "$EXPECTED_EPISODES" \
  --source-commit "$SOURCE_COMMIT" \
  --forward-checkpoint-sha256 "$FORWARD_SHA256" \
  --turn-checkpoint-sha256 "$TURN_SHA256" \
  "${SUMMARY_ARGS[@]}" \
  --output-dir "$SUMMARY_DIR" \
  > "$RUN_ROOT/final_gate.log" 2>&1
SUMMARY_STATUS=$?
set -e

if [ "$WORKER_STATUS" -ne 0 ]; then
  echo "worker_failure=$WORKER_STATUS"
  exit "$WORKER_STATUS"
fi
if [ "$CALIBRATION_STATUS" -ne 0 ]; then
  echo "calibration_gate_failure=$CALIBRATION_STATUS"
  exit 45
fi
if [ "$SUMMARY_STATUS" -ne 0 ]; then
  echo "summary_gate_failure=$SUMMARY_STATUS"
  exit 46
fi
read -r TECHNICAL_STATUS EXPOSURE_STATUS PAIRED < <(
  "$ASCENT_PYTHON" - "$SUMMARY_DIR/summary.json" <<'PY'
import json
import sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
print(
    value["technical_status"], value["exposure_status"],
    value["paired_valid_episodes"],
)
PY
)
[ "$TECHNICAL_STATUS" = PASS ] || exit 46
[ "$PAIRED" = "$EXPECTED_EPISODES" ] || exit 46
if [ "$MODE" = smoke ] && [ "$EXPOSURE_STATUS" != PASS ]; then
  echo smoke_mechanism_exposure_failure
  exit 46
fi
[ -z "$(git -C "$SOURCE_ROOT" status --porcelain --untracked-files=all)" ] || {
  echo source_changed_during_run
  exit 47
}
printf 'controller_exit_status=0 stage=complete dataset=%s mode=%s paired_valid=%s technical_status=%s exposure_status=%s time=%s\n' \
  "$DATASET" "$MODE" "$PAIRED" "$TECHNICAL_STATUS" "$EXPOSURE_STATUS" \
  "$(date -Is)" > "$RUN_ROOT/terminal_status.txt"
exit 0
